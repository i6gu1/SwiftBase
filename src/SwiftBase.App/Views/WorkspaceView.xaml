<UserControl x:Class="SwiftBase.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SwiftBase.ViewModels"
             xmlns:views="clr-namespace:SwiftBase.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="TabItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1"
                                Padding="12,0,8,0" Height="43">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#111C29" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeLeaf" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Explorer ============================ -->
        <Border Grid.Column="0" Background="#0A111A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- connection header -->
                <Grid Margin="15,15,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{Binding ActiveProfile.BadgeColor}"
                            BorderBrush="#263A4D" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveProfile.Badge}" Foreground="{Binding ActiveProfile.BadgeForeground}"
                                   FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveProfile.Name}" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="5" Height="5" Fill="{Binding ActiveProfile.EnvironmentColor}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding ActiveProfile.EngineName}" Foreground="{StaticResource DimBrush}" FontSize="10.5" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="⇄"
                                ToolTip="Switch connection (Ctrl+K)" Click="SwitchConnection_Click" />
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Content="⏻"
                                ToolTip="Disconnect" Command="{Binding DisconnectCommand}" />
                    </StackPanel>
                </Grid>

                <!-- database -->
                <StackPanel Grid.Row="1" Margin="15,16,15,0">
                    <TextBlock Text="DATABASE" Style="{StaticResource SectionLabel}" Margin="1,0,0,6" />
                    <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                              IsEnabled="{Binding CanSwitchDatabase}" FontSize="12"
                              ToolTip="Database switching is available for live connections" />
                </StackPanel>

                <!-- search -->
                <Grid Grid.Row="2" Margin="15,13,15,9">
                    <TextBox x:Name="ExplorerSearchBox" Text="{Binding ExplorerSearch, UpdateSourceTrigger=PropertyChanged}"
                             Padding="28,6,10,6" FontSize="12" />
                    <TextBlock Text="⌕" Foreground="{StaticResource DimBrush}" FontSize="15" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Filter tables…" Foreground="{StaticResource DimBrush}" FontSize="11.5" Margin="29,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding ExplorerSearch, Converter={StaticResource StringEmptyToVisibility}}" />
                </Grid>

                <!-- tree -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="6,0,6,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TableGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid Margin="9,7,9,5">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding CountLabel}" HorizontalAlignment="Right" FontSize="9.5"
                                                       Foreground="{StaticResource DimBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource TreeLeaf}" Click="Table_Click" ToolTip="{Binding QualifiedName}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="Consolas" FontSize="12"
                                                                       Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Width="18" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Margin="4,0,6,0" />
                                                            <Border Grid.Column="2" Background="#2A2111" CornerRadius="3" Padding="4,1"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasPrimaryKey, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="PK" FontSize="8" FontWeight="Bold" Foreground="{StaticResource YellowBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="10,30,10,0" Visibility="{Binding Tables.Count, Converter={StaticResource CountZeroToVisibility}}">
                            <TextBlock Text="No objects found" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="Try another filter." Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- footer -->
                <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,11">
                    <StackPanel>
                        <Button Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Click="NewQuery_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SQL" Foreground="{StaticResource CyanBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="New query" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="Ctrl T" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource DimBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                        <Grid Margin="9,10,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WorkspaceStatus}" Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="7,0,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Width="22" Height="22" Content="⌘" HorizontalAlignment="Right"
                                    ToolTip="Command palette (Ctrl+P)" Command="{Binding OpenPaletteCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================ Tabs + content ============================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#0B131D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="TabStrip"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource TabItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseDown="TabStrip_PreviewMouseDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Template>
                            <ControlTemplate TargetType="{x:Type ListBox}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#142333" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Consolas" FontSize="9.5"
                                                   Foreground="{StaticResource CyanBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <Ellipse Grid.Column="2" Width="5" Height="5" Fill="{StaticResource YellowBrush}" Margin="7,0,0,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="10"
                                            Margin="7,0,0,0" Content="✕" Command="{Binding CloseCommand}" ToolTip="Close tab" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="34" Height="32" Margin="6,0,9,0"
                            Content="+" FontSize="18" ToolTip="New SQL query (Ctrl+T)" Click="NewQuery_Click" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding SelectedTab}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:TableTabViewModel}">
                        <views:TableTabView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                        <views:QueryTabView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <Grid Grid.Row="1" Background="{StaticResource BgBrush}">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0">
                    <Grid Width="88" Height="88" HorizontalAlignment="Center">
                        <Ellipse Fill="#0E1A26" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                        <TextBlock Text="⌘" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Nothing open yet" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />
                    <TextBlock Text="Pick a table from the explorer, or start a blank SQL console."
                               Foreground="{StaticResource DimBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="New SQL query" Click="NewQuery_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource QuietButton}" Content="Command palette  Ctrl P" Command="{Binding OpenPaletteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
