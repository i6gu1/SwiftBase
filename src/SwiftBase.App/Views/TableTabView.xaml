<UserControl x:Class="SwiftBase.Views.TableTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftBase.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{StaticResource BgBrush}"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SegmentToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="FilterButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFilterOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFilterActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridText" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header / actions ============================ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" MinHeight="57">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="33" Height="33" CornerRadius="8" Background="{StaticResource CyanSoftBrush}"
                            BorderBrush="#1C3D4C" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Table.Glyph}" FontFamily="{StaticResource MonoFont}" FontSize="14"
                                   Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Table.Name}" Foreground="{StaticResource TextBrush}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Table.KindBadge}" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <Border Background="#1C2B3B" CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Table.Schema}" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}" />
                            </Border>
                            <Border Background="#2A2111" CornerRadius="4" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoPrimaryKey, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Without a primary key, updates and deletes match rows by their original values.">
                                <TextBlock Text="NO PK" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource YellowBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="0,2,0,0">
                            <Run Text="{Binding Table.QualifiedName, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding SelectionKindLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource SegmentToggle}" Content="Data"
                                          automation:AutomationProperties.Name="Data"
                                          automation:AutomationProperties.AutomationId="DataModeToggle"
                                          IsChecked="{Binding IsDataMode, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SegmentToggle}" Content="Structure"
                                          automation:AutomationProperties.Name="Structure"
                                          automation:AutomationProperties.AutomationId="StructureModeToggle"
                                          IsChecked="{Binding IsStructure, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButton}" Content="⟳" ToolTip="Refresh (F5)"
                            Command="{Binding RefreshCommand}" Width="28" Height="28" Margin="0,0,2,0" />
                    <Button Style="{StaticResource FilterButton}" Command="{Binding ToggleFilterCommand}"
                            ToolTip="Filter rows (Ctrl+F)" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌕" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Filter" FontSize="11.5" VerticalAlignment="Center" />
                            <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AddRowCommand}"
                            ToolTip="Stage a new row (Ctrl+N)" Margin="0,0,2,0"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"
                            Content="+ Row" />
                    <Button Style="{StaticResource QuietButton}" Content="SQL" Padding="8,6" FontSize="9.5"
                            FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                            ToolTip="Preview the SQL for staged changes" Command="{Binding PreviewSqlCommand}"
                            Margin="0,0,3,0" />
                    <Button Style="{StaticResource IconButton}" Content="↺" ToolTip="Discard all pending changes"
                            Command="{Binding DiscardChangesCommand}" Width="28" Height="28" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                            ToolTip="Save all staged changes in one transaction (Ctrl+S)" Padding="13,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Save" FontSize="12" FontWeight="Bold" />
                            <Border Background="#3A2E14" CornerRadius="4" Padding="5,1" Margin="7,0,0,0"
                                    Visibility="{Binding PendingCount, Converter={StaticResource CountNonZeroToVisibility}}">
                                <TextBlock Text="{Binding PendingCount}" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{StaticResource YellowBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Filter panel ============================ -->
        <Border Grid.Row="1" Background="#0B141E" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10"
                Visibility="{Binding IsFilterOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="WHERE" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                <ComboBox Width="168" ItemsSource="{Binding FilterColumns}" SelectedItem="{Binding FilterColumn, Mode=TwoWay}" />
                <ComboBox Width="132" Margin="8,0,0,0" ItemsSource="{Binding FilterOperators}" SelectedItem="{Binding FilterOperator, Mode=TwoWay}" />
                <TextBox x:Name="FilterValueBox" Width="260" Margin="8,0,0,0"
                         Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="FilterValue_KeyDown" />
                <Button Style="{StaticResource PrimaryButton}" Content="Apply" Command="{Binding ApplyFilterCommand}"
                        Margin="8,0,0,0" Padding="14,7" />
                <Button Style="{StaticResource QuietButton}" Content="Clear" Command="{Binding ClearFilterCommand}"
                        Margin="6,0,0,0" />
                <TextBlock Text="Press Enter to apply" Foreground="{StaticResource DimBrush}" FontSize="10.5"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ============================ Data + inspector ============================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#211806" BorderBrush="#3D2E12" BorderThickness="0,0,0,1"
                        Padding="14,7" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="READ-ONLY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource YellowBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReadOnlyReason}" Foreground="#D9C28A" FontSize="11" Margin="9,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="Grid"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              SelectionUnit="CellOrRowHeader"
                              CurrentCellChanged="Grid_CurrentCellChanged"
                              Sorting="Grid_Sorting"
                              MouseDoubleClick="Grid_MouseDoubleClick"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                              PreviewKeyDown="Grid_PreviewKeyDown"
                              Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Edit in inspector" InputGestureText="Space" Click="Inspector_Click" />
                                <MenuItem Header="Copy value" InputGestureText="Ctrl+C" Click="CopyCell_Click" />
                                <MenuItem Header="Revert cell" Click="RevertCell_Click" />
                                <MenuItem Header="Set NULL" Click="SetNull_Click" />
                                <Separator />
                                <MenuItem Header="Stage new row" Command="{Binding AddRowCommand}" />
                                <MenuItem Header="Delete row" Command="{Binding DeleteRowCommand}" />
                                <Separator />
                                <MenuItem Header="Preview SQL…" Command="{Binding PreviewSqlCommand}" />
                                <MenuItem Header="Save changes" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <DataGrid x:Name="StructureGrid"
                              ItemsSource="{Binding Columns}"
                              Visibility="{Binding ShowStructure, Converter={StaticResource BoolToVisibility}}"
                              SelectionUnit="FullRow"
                              IsReadOnly="True"
                              Margin="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="52"
                                                ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="COLUMN" Binding="{Binding Name}" Width="240"
                                                ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding DataType}" Width="180"
                                                ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="KEY" Binding="{Binding KeyLabel}" Width="70"
                                                ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="NULLABLE" Binding="{Binding NullableLabel}" Width="110"
                                                ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="DEFAULT" Binding="{Binding DefaultLabel}" Width="*"
                                                ElementStyle="{StaticResource GridText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Margin="0,-10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Rows.Count}" Value="0" />
                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                            <Condition Binding="{Binding ShowGrid}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="54" Height="54" CornerRadius="14" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <TextBlock Text="▦" FontSize="20" Foreground="{StaticResource DimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No rows to display" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="Adjust the filter, refresh the page, or stage a new row."
                                   Foreground="{StaticResource DimBrush}" FontSize="11" HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- loading state -->
                    <Border Background="#99070C13" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Loading page…" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Reading a bounded page of 500 rows" Foreground="{StaticResource DimBrush}"
                                       FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,12" />
                            <ProgressBar IsIndeterminate="True" Width="180" />
                        </StackPanel>
                    </Border>

                    <!-- query error -->
                    <Border Background="{StaticResource RedSoftBrush}" BorderBrush="#532A31" BorderThickness="1"
                            CornerRadius="8" Padding="13,10" Margin="16" VerticalAlignment="Top" HorizontalAlignment="Center"
                            MaxWidth="620"
                            Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="QUERY FAILED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RedBrush}" />
                                <TextBlock Text="{Binding LoadError}" Foreground="#F3B4B4" FontSize="11.5" TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="Retry"
                                    Command="{Binding RefreshCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================ Inspector ============================ -->
            <Border Grid.Column="1" Width="382" Background="#0A111A" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0" Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="15,13,10,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INSPECTOR" Style="{StaticResource SectionLabel}" />
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding InspectorType}" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}" />
                            </Border>
                            <Border Background="#2A2111" CornerRadius="4" Padding="5,1" Margin="5,0,0,0"
                                    Visibility="{Binding InspectorIsNull, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="NULL" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource YellowBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" Content="✕"
                                ToolTip="Close inspector (Esc)" Command="{Binding CloseInspectorCommand}" FontSize="10" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="15,0,15,10">
                        <TextBlock Text="{Binding InspectorColumnName}" Foreground="{StaticResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="{Binding InspectorRowCaption}" Foreground="{StaticResource DimBrush}"
                                   FontSize="10.5" Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2" Margin="12,0,12,10" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2">
                        <controls:CodeEditor x:Name="InspectorEditor"
                                             Text="{Binding InspectorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Syntax="{Binding InspectorLanguage}"
                                             IsReadOnly="{Binding IsReadOnly}" />
                    </Border>

                    <Grid Grid.Row="3" Margin="15,0,15,13">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding InspectorStatus}" Foreground="{StaticResource DimBrush}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,9" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource QuietButton}" Content="Set NULL"
                                    Command="{Binding SetInspectorNullCommand}" Padding="8,6" FontSize="11" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource QuietButton}" Content="Revert"
                                        Command="{Binding RevertInspectorCommand}" Padding="8,6" FontSize="11" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Apply" Margin="6,0,0,0"
                                        Command="{Binding ApplyInspectorCommand}" Padding="13,7" FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Read-only view — edits are disabled."
                                   Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,8,0,0"
                                   Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Status bar ============================ -->
        <Border Grid.Row="3" Height="35" Background="#0B131D" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{StaticResource YellowBrush}"
                             Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{StaticResource GreenBrush}">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding PendingLabel}" Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="{StaticResource DimBrush}"
                               FontSize="10.5" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilterSummary}" Foreground="{StaticResource AccentBrush}" FontSize="10"
                               Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    <TextBlock Text="{Binding LastQueryMs, StringFormat={}{0} ms}" Foreground="{StaticResource DimBrush}"
                               FontSize="10" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RowRangeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10.5"
                               Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Width="23" Height="23" Content="‹" FontSize="15"
                            Command="{Binding PrevPageCommand}" ToolTip="Previous page" />
                    <TextBlock Text="{Binding PageLabel}" Foreground="{StaticResource TextBrush}" FontSize="10.5"
                               Margin="6,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Width="23" Height="23" Content="›" FontSize="15"
                            Command="{Binding NextPageCommand}" ToolTip="Next page" Margin="0,0,6,0" />
                    <Border Style="{StaticResource Chip}" Padding="6,2">
                        <TextBlock Text="{Binding PageSizeLabel}" FontSize="9.5" Foreground="{StaticResource DimBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
