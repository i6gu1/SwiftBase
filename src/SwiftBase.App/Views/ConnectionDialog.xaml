<Window x:Class="SwiftBase.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="New connection"
        Width="780" Height="730"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        AllowsTransparency="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="1,0,0,5" />
        </Style>
        <Style x:Key="FieldGap" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <!-- ============================ Title bar ============================ -->
            <Border Background="#0B131D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,7,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="#4A2D18" BorderThickness="1">
                            <TextBlock Text="⛁" Foreground="{StaticResource AccentBrush}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="New connection" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                   FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="· SQLite, PostgreSQL or MySQL" Foreground="{StaticResource DimBrush}"
                                   FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Click="CloseButton_Click" ToolTip="Close" />
                </Grid>
            </Border>

            <!-- ============================ Form ============================ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,18,20,10">
                <StackPanel MaxWidth="720">
                    <TextBlock Text="Connect to a database" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="SwiftBase reads the schema, then streams only the rows you can see. Credentials never leave this machine unencrypted."
                               Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="610"
                               Margin="0,6,0,0" LineHeight="17" />

                    <!-- URL import -->
                    <Border Background="#0A121B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="14,12" Margin="0,17,0,0">
                        <StackPanel>
                            <TextBlock Text="PASTE A CONNECTION URL — OPTIONAL" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UrlBox" Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="postgres://user:pass@host:5432/db or mysql://user:pass@host/db or a .sqlite path" />
                                <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="Import"
                                        Click="ImportUrl_Click" Margin="8,0,0,0" Padding="13,7" />
                                <TextBlock Grid.Column="2" Text="{Binding EngineHint}" Foreground="{StaticResource DimBrush}"
                                           FontSize="9.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding ImportStatus}" FontSize="10.5" Margin="2,7,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                        <Setter Property="Visibility" Value="{Binding HasImportStatus, Converter={StaticResource BoolToVisibility}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImportSucceeded}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Engine -->
                    <TextBlock Text="ENGINE" Style="{StaticResource SectionLabel}" Margin="1,18,0,7" />
                    <UniformGrid Columns="3">
                        <RadioButton Style="{StaticResource EngineCard}" GroupName="Engine" Tag="Sqlite"
                                     IsChecked="{Binding Engine, Converter={StaticResource EnumEquals}, ConverterParameter=Sqlite}"
                                     Checked="Engine_Checked" Margin="0,0,5,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◇" Foreground="{StaticResource GreenBrush}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="SQLite" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Local file · no server" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource EngineCard}" GroupName="Engine" Tag="Postgres"
                                     IsChecked="{Binding Engine, Converter={StaticResource EnumEquals}, ConverterParameter=Postgres}"
                                     Checked="Engine_Checked" Margin="2,0,2,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌁" Foreground="{StaticResource CyanBrush}" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="PostgreSQL" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Server · port 5432" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource EngineCard}" GroupName="Engine" Tag="MySql"
                                     IsChecked="{Binding Engine, Converter={StaticResource EnumEquals}, ConverterParameter=MySql}"
                                     Checked="Engine_Checked" Margin="5,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="MySQL" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Server · port 3306" Foreground="{StaticResource DimBrush}" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- Details -->
                    <TextBlock Text="CONNECTION DETAILS" Style="{StaticResource SectionLabel}" Margin="1,18,0,7" />
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NAME" Style="{StaticResource FormLabel}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="A friendly name for the connection list" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ENVIRONMENT" Style="{StaticResource FormLabel}" />
                                    <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- SQLite -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsSqlite, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="DATABASE FILE" Style="{StaticResource FormLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Path to a .sqlite, .sqlite3 or .db file" />
                                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="Browse…"
                                            Click="BrowseSqlite_Click" Margin="8,0,0,0" Padding="13,7" />
                                </Grid>
                                <TextBlock Text="The file is opened in read/write mode. Changes are staged until you press Ctrl+S."
                                           Foreground="{StaticResource DimBrush}" FontSize="9.5" Margin="2,5,0,0" />
                            </StackPanel>

                            <!-- Server -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsServerBased, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HOST" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PORT" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DATABASE" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="USERNAME" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,11,0,0">
                                    <TextBlock Text="PASSWORD" Style="{StaticResource FormLabel}" />
                                    <PasswordBox x:Name="NewPasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="TLS TRUST" Style="{StaticResource SectionLabel}" Margin="0,0,0,7" />
                                    <CheckBox Content="Allow unverified TLS (insecure — only for legacy self-signed servers)"
                                              IsChecked="{Binding AllowUnverifiedTls, Mode=TwoWay}"
                                              Foreground="#F3B4B4" FontSize="10.5" ToolTip="Disables server certificate and hostname verification. Only use on a trusted network." />
                                    <TextBlock Text="TRUSTED CA FILE (OPTIONAL, PEM)" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
                                    <TextBox Text="{Binding RootCertificatePath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="PEM CA bundle used to verify the database server certificate" />
                                    <TextBlock Text="Direct connections verify the server certificate and hostname by default. SSH-tunneled legs use the verified SSH host key."
                                               Foreground="{StaticResource DimBrush}" FontSize="9.5" Margin="2,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SSH -->
                    <CheckBox Content="Connect through an SSH tunnel" IsChecked="{Binding UseSsh, Mode=TwoWay}"
                              Margin="1,15,0,0" Visibility="{Binding IsServerBased, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="#0A121B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="14" Margin="0,10,0,0"
                            Visibility="{Binding UseSsh, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="SSH TUNNEL" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SSH HOST" Style="{StaticResource FormLabel}" />
                                    <TextBox Text="{Binding SshHost, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SSH PORT" Style="{StaticResource FormLabel}" />
                                    <TextBox Text="{Binding SshPortText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SSH USERNAME" Style="{StaticResource FormLabel}" />
                                    <TextBox Text="{Binding SshUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SSH PASSWORD" Style="{StaticResource FormLabel}" />
                                    <PasswordBox x:Name="SshPasswordBox" PasswordChanged="SshPasswordBox_PasswordChanged" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PRIVATE KEY PATH (OPTIONAL)" Style="{StaticResource FormLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SshKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="OpenSSH private key, e.g. C:\Users\you\.ssh\id_ed25519" />
                                        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="…"
                                                Click="BrowseKey_Click" Margin="8,0,0,0" Padding="11,7" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="KEY PASSPHRASE" Style="{StaticResource FormLabel}" />
                                    <PasswordBox x:Name="SshPassphraseBox" PasswordChanged="SshPassphraseBox_PasswordChanged" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Trust this SSH host key on first use (verify its fingerprint out of band)"
                                      IsChecked="{Binding TrustNewHostKey, Mode=TwoWay}"
                                      Margin="0,11,0,0" FontSize="10.5" />
                            <TextBlock Text="Provide the SSH password, a private key, or both. Unknown host keys are refused until you explicitly enable first-use trust; changed keys are always refused."
                                       Foreground="{StaticResource DimBrush}" FontSize="9.5" Margin="2,9,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Feedback -->
                    <Border CornerRadius="7" Padding="11,8" Margin="0,13,0,0"
                            Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}"
                            Background="{StaticResource RedSoftBrush}" BorderBrush="#532A31" BorderThickness="1">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#F3B4B4" FontSize="11" TextWrapping="Wrap" />
                    </Border>

                    <Border CornerRadius="7" Padding="11,8" Margin="0,13,0,0"
                            Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                                <Setter Property="BorderBrush" Value="#532A31" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="#1B4A3A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TestMessage}" FontSize="11" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#F3B4B4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                            <Setter Property="Foreground" Value="#8BE8C4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Footer ============================ -->
            <Border Grid.Row="2" Background="#0B131D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="22,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⛨" Foreground="{StaticResource GreenBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="Secrets are protected with Windows DPAPI for your user account."
                                   Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="7,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource QuietButton}" Content="Cancel" Click="CancelButton_Click"
                                IsCancel="True" Padding="15,8" Margin="0,0,8,0" />
                        <Button Style="{StaticResource QuietButton}" Content="Test connection" Click="TestButton_Click"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
                                Padding="15,8" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Connect" Click="ConnectButton_Click"
                                IsDefault="True" Padding="22,8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
