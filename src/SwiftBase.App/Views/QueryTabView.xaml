<UserControl x:Class="SwiftBase.Views.QueryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SwiftBase.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{StaticResource BgBrush}"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="ResultText" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="150" />
            <RowDefinition Height="9" />
            <RowDefinition Height="3*" MinHeight="130" />
        </Grid.RowDefinitions>

        <!-- ============================ Toolbar ============================ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Height="55">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                        <TextBlock Text="SQL" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13"
                               FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Database}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <Border Background="#0E3024" CornerRadius="4" Padding="6,2" Margin="5,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                    </Border>
                    <TextBlock Text="Ctrl + Enter runs the selection, or the whole script"
                               Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="92" Margin="0,0,12,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ElapsedLabel}" Foreground="{StaticResource DimBrush}" FontSize="10.5"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource DangerButton}" Content="Cancel" Padding="11,7" FontSize="11.5"
                            Command="{Binding CancelCommand}" Margin="0,0,7,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"
                            ToolTip="Run the selected SQL, or the entire editor (Ctrl+Enter)" Padding="15,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="Run" FontSize="12" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Editor ============================ -->
        <Border Grid.Row="1" Margin="12,10,12,0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#0B141E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0" Padding="12,6">
                    <Grid>
                        <TextBlock Text="QUERY EDITOR" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="autocomplete on typing · Ctrl+Space" Foreground="{StaticResource DimBrush}"
                                   FontSize="9.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <controls:CodeEditor x:Name="SqlEditor" Grid.Row="1" Margin="2"
                                     Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Syntax="sql" />
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="9" HorizontalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="Transparent">
                        <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ============================ Results ============================ -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,1" Height="39">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <Border Background="#2A2111" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="TRUNCATED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource YellowBrush}" />
                        </Border>
                        <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource DimBrush}" FontSize="10.5"
                                   Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ElapsedLabel}" Foreground="{StaticResource DimBrush}" FontSize="10"
                                   Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource QuietButton}" Content="CSV" Padding="9,4" FontSize="10.5"
                                Click="ExportCsv_Click" IsEnabled="{Binding CanExport}" ToolTip="Export rows as CSV"
                                Margin="0,0,3,0" />
                        <Button Style="{StaticResource QuietButton}" Content="JSON" Padding="9,4" FontSize="10.5"
                                Click="ExportJson_Click" IsEnabled="{Binding CanExport}" ToolTip="Export rows as JSON"
                                Margin="0,0,3,0" />
                        <Button Style="{StaticResource QuietButton}" Content="INSERT" Padding="9,4" FontSize="10.5"
                                Click="ExportInserts_Click" IsEnabled="{Binding CanExport}"
                                ToolTip="Export rows as INSERT statements" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource RedSoftBrush}" BorderBrush="#532A31" BorderThickness="0,0,0,1"
                    Padding="16,9" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="QUERY ERROR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource RedBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F3B4B4" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,3,0,0" MaxHeight="96" />
                </StackPanel>
            </Border>

            <DataGrid x:Name="ResultGrid"
                      Grid.Row="2"
                      ItemsSource="{Binding ResultView}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"
                      IsReadOnly="True"
                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasResults}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                    <Condition Binding="{Binding IsRunning}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-6,0,0">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="›_" FontFamily="{StaticResource MonoFont}" FontSize="17"
                                   Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,13,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="{Binding ResultMessage}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultMessage}" Value="">
                                        <Setter Property="Text" Value="No result set yet" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Write a statement above and press Ctrl+Enter. Up to 5,000 rows are returned."
                               Foreground="{StaticResource DimBrush}" FontSize="11" HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
