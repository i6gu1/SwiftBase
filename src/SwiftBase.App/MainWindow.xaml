<Window x:Class="SwiftBase.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SwiftBase.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1440" Height="880"
        MinWidth="840" MinHeight="460"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder" BorderBrush="#223447" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================ Title bar ============================ -->
            <Border Grid.Row="0" Background="#0A111A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="27" Height="27" Stretch="Uniform" />
                        <TextBlock Text="SwiftBase" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Bold"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource DimBrush}" />
                        </Border>

                        <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="14,0" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Width="6" Height="6" Fill="{Binding ActiveProfile.EnvironmentColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveProfile.Name}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="·" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedDatabase}" Foreground="{StaticResource DimBrush}" FontSize="10.5"
                                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>

                        <TextBlock Text="Welcome" Foreground="{StaticResource DimBrush}" FontSize="10.5" VerticalAlignment="Center"
                                   Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>

                    <Button Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource QuietButton}" Click="Palette_Click" Padding="11,5" ToolTip="Command palette (Ctrl+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌘" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Command palette" FontSize="11" Margin="7,0,8,0" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="Ctrl P" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                           Foreground="{StaticResource DimBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;"
                                Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Content ============================ -->
            <Grid Grid.Row="1">
                <views:WelcomeView Visibility="{Binding WelcomeVisible, Converter={StaticResource BoolToVisibility}}" />
                <views:WorkspaceView Visibility="{Binding WorkspaceVisible, Converter={StaticResource BoolToVisibility}}" />

                <!-- toast -->
                <Border x:Name="ToastHost" Panel.ZIndex="100" MaxWidth="520" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,22,22" Padding="13,11"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="#101B28" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="8" Opacity="0.45" Color="#000000" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="#5A2C33" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,10,0">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Foreground="{StaticResource TextBrush}"
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                    </Grid>
                </Border>

                <!-- command palette -->
                <Grid Panel.ZIndex="200" Background="#C4070C13"
                      Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisibility}}"
                      MouseLeftButtonDown="PaletteBackdrop_MouseLeftButtonDown">
                    <Border Width="660" MaxHeight="560" VerticalAlignment="Top" Margin="0,88,0,0"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="34" ShadowDepth="14" Opacity="0.6" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="17,13,12,3">
                                <TextBlock Text="{Binding PaletteTitle}" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="Esc to close" Foreground="{StaticResource DimBrush}" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1" Margin="12,6,12,7" Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <TextBlock Text="⌕" Foreground="{StaticResource DimBrush}" FontSize="16"
                                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBox x:Name="PaletteSearchBox"
                                             Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Padding="32,10,10,10"
                                             FontSize="13" KeyDown="PaletteSearchBox_KeyDown" />
                                    <TextBlock Text="{Binding PalettePlaceholder}" Foreground="{StaticResource DimBrush}"
                                               FontSize="12.5" Margin="33,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding PaletteQuery, Converter={StaticResource StringEmptyToVisibility}}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" MinHeight="70">
                                <ListBox x:Name="PaletteList" MaxHeight="368" Margin="8,0,8,4"
                                         ItemsSource="{Binding PaletteResults}"
                                         SelectedItem="{Binding SelectedPaletteItem, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource PaletteItemStyle}"
                                         PreviewMouseLeftButtonUp="PaletteList_PreviewMouseLeftButtonUp"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="31" Height="31" CornerRadius="7" Background="{StaticResource Surface3Brush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                               FontWeight="Bold" Foreground="{StaticResource CyanBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource DimBrush}" FontSize="10"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="↵" Foreground="{StaticResource DimBrush}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,14"
                                            Visibility="{Binding PaletteResults.Count, Converter={StaticResource CountZeroToVisibility}}">
                                    <TextBlock Text="No matches" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Try a table name, action or connection." Foreground="{StaticResource DimBrush}"
                                               FontSize="10.5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Padding="14,8" Background="#0B141E" CornerRadius="0,0,12,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↑ ↓" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="navigate" Foreground="{StaticResource DimBrush}" FontSize="9.5" Margin="6,0,14,0" />
                                        <TextBlock Text="↵" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="open" Foreground="{StaticResource DimBrush}" FontSize="9.5" Margin="6,0,14,0" />
                                        <TextBlock Text="esc" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="close" Foreground="{StaticResource DimBrush}" FontSize="9.5" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PaletteResults.Count, StringFormat={}{0} results}"
                                               Foreground="{StaticResource DimBrush}" FontSize="9.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- connecting overlay -->
                <Grid Panel.ZIndex="300" Background="#B8070C13"
                      Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="34,28" Width="330"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Image Source="/Assets/logo.png" Width="62" Height="62" HorizontalAlignment="Center" />
                            <TextBlock Text="Opening connection…" Foreground="{StaticResource TextBrush}" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,13,0,0" />
                            <TextBlock Text="Verifying credentials and reading the schema" Foreground="{StaticResource DimBrush}"
                                       FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,15" />
                            <ProgressBar IsIndeterminate="True" Width="210" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
